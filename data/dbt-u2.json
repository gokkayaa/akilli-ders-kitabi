         51.61,
         1.96
        ]
       },
       {
        "sp": "Karagöz",
        "t": "Haydi, sor bakalım Hacı Cavcav. Yazarım.",
        "page": 30,
        "r": [
         17.46,
         43.7,
         45.56,
         1.96
        ]
       },
       {
        "sp": "Hacivat",
        "t": "“Yazar mısın?” demedim Karagöz’üm. “Hazır mısın?” dedim.",
        "page": 30,
        "r": [
         17.46,
         45.73,
         61.46,
         1.96
        ]
       },
       {
        "sp": "Karagöz",
        "t": "Tamam tamam, hazırım.",
        "page": 30,
        "r": [
         17.46,
         47.77,
         30.59,
         1.96
        ]
       },
       {
        "sp": "Hacivat",
        "t": "Ayakları var, insan değil. Sınıfta var, masa değil.",
        "page": 30,
        "r": [
         17.46,
         49.8,
         48.72,
         4.0
        ]
       },
       {
        "sp": "Karagöz",
        "t": "Öğrenci.",
        "page": 30,
        "r": [
         17.46,
         53.87,
         16.38,
         1.96
        ]
       },
       {
        "sp": "Hacivat",
        "t": "Hayır Karagöz’üm. İnsan değil. İyi düşün, tekrar söyle.",
        "page": 30,
        "r": [
         17.46,
         55.9,
         56.01,
         1.96
        ]
       },
       {
        "sp": "Karagöz",
        "t": "Sıra!",
